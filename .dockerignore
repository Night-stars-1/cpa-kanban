# Secrets and local configuration never enter the build context.
.env
.env.*
**/.env
**/.env.*
!.env.example

# Installed and generated locally; the build stage recreates both.
node_modules
dist
*.log
logs

# Repository metadata and tooling state.
.git
.gitignore
.vscode
.idea
.DS_Store
Thumbs.db

# Transient directories and non-build documentation.
coverage
.tmp
tmp
temp
README.md
CHANGELOG.md
