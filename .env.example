# CPA Manager Plus Full Mode 地址，不是纯 CPA :8317。
CPA_MANAGER_BASE_URL=http://127.0.0.1:18317

# Manager Admin Key，不是模型 API Key。请填写真实密钥，仅服务端读取。
CPA_MANAGER_ADMIN_KEY=

# Node.js 直接运行时的监听地址。Docker 中固定为 0.0.0.0。
HOST=127.0.0.1

# 看板端口；Docker Compose 中表示宿主机端口，容器内部固定为 5173。
PORT=5173

# 可选：非本机访问时填写浏览器访问的完整来源，不含路径。
# 例如 https://cpa.example.com 或 http://192.168.10.105:5173
PUBLIC_ORIGIN=

# 仅 Docker Compose，可选：覆盖使用的镜像。默认 ghcr.io/night-stars-1/cpa-kanban:latest，
# 也可指定 sha- 或版本标签，或改用本地构建标签，例如 cpa-insight:local。
# CPA_INSIGHT_IMAGE=ghcr.io/night-stars-1/cpa-kanban:latest

# 仅 Docker Compose：默认只向宿主机回环地址发布端口。
# 如需开放局域网，改为 0.0.0.0 并配置 PUBLIC_ORIGIN；公网请使用带鉴权的反向代理。
BIND_ADDRESS=127.0.0.1
